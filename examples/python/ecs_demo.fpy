# A Feather script: dropped in the project, found by extension, run at load.
#
# No .fext manifest and no build step -- .fpy is the file saying "run me". The
# neighbouring projection_demo.py takes the other route, a manifest naming it,
# which is still how you give a script a declared name and type.
#
# What this one shows is the part a manifest cannot give you: defining ECS
# types. The component below becomes a real component in the same world the
# engine's own live in, and the system below runs in the frame loop.
import feather_ecs


@feather_ecs.component
class Drift:
    speed: float
    steps: int
    offset: "vec3"


print("[ecs_demo] component Drift registered")


@feather_ecs.system("Drift", phase="on_update")
def advance(entity, drift, dt):
    # Bounded so a headless run's log stays readable; the point is that this
    # runs at all, and that what it writes persists between frames.
    if drift.steps >= 3:
        return
    drift.steps = drift.steps + 1
    drift.speed = drift.speed + 2.5
    x, y, z = drift.offset
    drift.offset = (x + 1.0, y + 2.0, z + 3.0)
    print(
        "[ecs_demo] tick %d: speed %.1f offset %s"
        % (drift.steps, drift.speed, drift.offset)
    )


print("[ecs_demo] system advance registered")

# A system over one of the engine's own components, to show that a scripted
# query is not limited to scripted types.
@feather_ecs.system("Transform", phase="on_update", name="ScriptReadsTransform")
def read_transform(entity, transform, dt):
    pass


print("[ecs_demo] system over engine Transform registered")

entity = feather_ecs.spawn(Drift, name="DriftDemo")
view = feather_ecs.component_view(entity, "Drift")

# Fields start zero-initialized, like any other component.
print(
    "[ecs_demo] initial speed %.1f steps %d offset %s"
    % (view.speed, view.steps, view.offset)
)

view.speed = 1.0
view.offset = (10.0, 20.0, 30.0)
print(
    "[ecs_demo] seeded speed %.1f offset %s"
    % (view.speed, view.offset)
)

# Field types the engine cannot lay out are refused, not silently dropped.
try:
    feather_ecs.define_component("Unstorable", [("text", "string")])
    print("[ecs_demo] ERROR: a string field was accepted")
except Exception as error:
    print("[ecs_demo] string field refused:", error)
