<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The generated bindings are full of pointer work. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Publishing with NativeLib=Shared turns this library into a plain
         native .so exporting the [UnmanagedCallersOnly] entry points below,
         which is the only shape the engine's extension loader can dlopen.
         A normal managed assembly would need a CLR host to run. -->
    <PublishAot>true</PublishAot>
    <!-- Generated code is not ours to tidy; it warns a lot. -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0465;CS8500;CA1416</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- FeatherCsharpDir is where the SDK generated the C# bindings from
       api/feather_api.json; the xmake target that drives `dotnet publish`
       passes it in. -->
  <ItemGroup>
    <Compile Include="CsExample.cs" />
    <Compile Include="$(FeatherCsharpDir)/**/*.cs" />
  </ItemGroup>

  <!-- No rpath, and nothing pointing into an engine build tree: the P/Invokes
       are resolved at runtime against the copy of libfeather_c the engine has
       already loaded (see CsExample.cs's resolver). That is what lets this
       plugin be built and shipped without knowing where the engine lives. -->

</Project>
